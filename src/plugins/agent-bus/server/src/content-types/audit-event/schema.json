      "target": "plugin::agent-bus.agent"
    },
    "actorLabel": {
      "type": "string"
    },
    "entityType": {
      "type": "string"
    },
    "entityDocumentId": {
      "type": "string"
    },
    "requestId": {
      "type": "string"
    },
    "metadata": {
      "type": "json",
      "default": {}
    }
  }
