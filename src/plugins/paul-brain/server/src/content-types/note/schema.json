{
  "kind": "collectionType",
  "collectionName": "paul_brain_notes",
  "info": {
    "singularName": "note",
    "pluralName": "notes",
    "displayName": "Note",
    "description": "Brain notes: facts, preferences, ideas, todos, logs, and references"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "aliases": {
      "type": "json",
      "default": []
    },
    "body": {
      "type": "richtext"
    },
    "summary": {
      "type": "text",
      "maxLength": 280
    },
    "kind": {
      "type": "enumeration",
      "enum": ["fact", "preference", "idea", "todo", "log", "reference"],
      "default": "fact"
    },
    "tags": {
      "type": "json",
      "default": []
    },
    "confidence": {
      "type": "enumeration",
      "enum": ["low", "medium", "high"],
      "default": "medium"
    },
    "source_bot": {
      "type": "string"
    },
    "pinned": {
      "type": "boolean",
      "default": false
    },
    "expires_on": {
      "type": "date"
    },
    "people": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::paul-brain.person",
      "inversedBy": "notes"
    },
    "projects": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::paul-brain.project",
      "inversedBy": "notes"
    },
    "sources": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::paul-brain.source",
      "inversedBy": "notes"
    },
    "decisions": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::paul-brain.decision",
      "inversedBy": "notes"
    }
  }
}
