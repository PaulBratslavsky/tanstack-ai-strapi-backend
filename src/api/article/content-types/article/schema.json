{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "Demo content for exercising Strapi's MCP tools"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title" },
    "body": { "type": "text" },
    "category": {
      "type": "enumeration",
      "enum": ["tutorial", "announcement", "guide"],
      "default": "tutorial"
    },
    "publishedDate": { "type": "date" }
  }
}
